<Window x:Class="Lab5.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация - ВелосипедДрайв" Height="450" Width="700" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0" Source="/Images/icon.png" Margin="20" Stretch="Uniform"/>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,40,0">
            <TextBlock Text="Вход в систему" FontSize="26" FontWeight="Bold" Foreground="#4B0082" Margin="0,0,0,20"/>

            <TextBlock Text="Логин:" Margin="0,0,0,5"/>
            <TextBox x:Name="LoginBox" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="Пароль:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox" Height="30" Margin="0,0,0,20"/>

            <Button Content="Войти" Height="40" Style="{StaticResource AccentButton}" Click="LoginButton_Click"/>
            <Button Content="Войти как гость" Height="30" Margin="0,10,0,0" Click="GuestButton_Click"/>
        </StackPanel>
    </Grid>
</Window>