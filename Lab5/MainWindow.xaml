<Window x:Class="Lab5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Lab5.Converters"
        Title="Список товаров - ВелосипедДрайв" Height="700" Width="1000" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:ImageSourceConverter x:Key="ImageConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
            <TextBlock x:Name="UserInfoText" Text="Роль: Гость" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="Bold"/>
            <Button Content="Выход" Padding="10,5" Click="ExitButton_Click"/>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="Средства поиска" Margin="0,0,0,10" x:Name="SearchGroup">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="SearchBox" Width="300" TextChanged="SearchBox_TextChanged" Padding="5"/>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10" x:Name="AdminPanel">
            <Button x:Name="AddButton" Content="Добавить товар" Width="150" Margin="0,0,10,0" Click="AddButton_Click"/>
            <Button x:Name="EditButton" Content="Редактировать" Width="150" Margin="0,0,10,0" Click="EditButton_Click"/>
            <Button x:Name="DeleteButton" Content="Удалить" Width="150" Margin="0,0,10,0" Click="DeleteButton_Click"/>
            <Button x:Name="OrdersButton" Content="Заказы" Width="150" Click="OrdersButton_Click"/>
        </StackPanel>

        <ListBox Grid.Row="3" x:Name="ProductsList" ItemsSource="{Binding Products}" HorizontalContentAlignment="Stretch" MouseDoubleClick="EditButton_Click">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" Margin="0,5" Padding="5" CornerRadius="5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Discount}" Value="18">
                                        <Setter Property="Background" Value="#483D8B"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Discount}" Value="20">
                                        <Setter Property="Background" Value="#483D8B"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Discount}" Value="25">
                                        <Setter Property="Background" Value="#483D8B"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Discount}" Value="30">
                                        <Setter Property="Background" Value="#483D8B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <!-- ТУТ ИСПОЛЬЗУЕТСЯ КОНВЕРТЕР -->
                            <Image Grid.Column="0" Source="{Binding ImagePath, Converter={StaticResource ImageConverter}}" Stretch="Uniform" Margin="5" Height="100"/>

                            <StackPanel Grid.Column="1" Margin="10">
                                <TextBlock FontWeight="Bold" FontSize="14">
                                    <Run Text="{Binding Category.Name}"/>
                                    <Run Text=" | "/>
                                    <Run Text="{Binding Name}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxHeight="40" Margin="0,5"/>
                                <TextBlock Text="{Binding Manufacturer.Name, StringFormat='Производитель: {0}'}"/>
                                <TextBlock Text="{Binding Supplier.Name, StringFormat='Поставщик: {0}'}"/>
                                <TextBlock>
                                    <Run Text="Артикул: "/>
                                    <Run Text="{Binding Article}"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Цена: "/>
                                    <Run Text="{Binding Price, StringFormat={}{0:C}}" FontWeight="Bold"/>
                                    <Run Text="{Binding Discount, StringFormat=' (Скидка: {0}%)'}" Foreground="Yellow" FontWeight="Bold"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Count}" FontSize="20" HorizontalAlignment="Center" FontWeight="Bold"/>
                                <TextBlock Text="шт." HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>