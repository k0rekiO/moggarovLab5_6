<Window x:Class="Lab5.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование товара" Height="600" Width="500" WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="ID:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="IdBox" Grid.Row="0" Grid.Column="1" Margin="5" IsReadOnly="True" Background="#EEEEEE"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Артикул:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="ArticleBox" Grid.Row="1" Grid.Column="1" Margin="5"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Наименование:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="NameBox" Grid.Row="2" Grid.Column="1" Margin="5"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Категория:" VerticalAlignment="Center" Margin="5"/>
        <ComboBox x:Name="CategoryCombo" Grid.Row="3" Grid.Column="1" Margin="5" DisplayMemberPath="Name"/>
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Описание:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="DescBox" Grid.Row="4" Grid.Column="1" Margin="5" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
        <TextBlock Grid.Row="5" Grid.Column="0" Text="Производитель:" VerticalAlignment="Center" Margin="5"/>
        <ComboBox x:Name="ManufacturerCombo" Grid.Row="5" Grid.Column="1" Margin="5" DisplayMemberPath="Name"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Поставщик:" VerticalAlignment="Center" Margin="5"/>
        <ComboBox x:Name="SupplierCombo" Grid.Row="6" Grid.Column="1" Margin="5" DisplayMemberPath="Name"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Ед. измерения:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="UnitBox" Grid.Row="7" Grid.Column="1" Margin="5" Text="шт."/>
        <TextBlock Grid.Row="8" Grid.Column="0" Text="Цена:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="PriceBox" Grid.Row="8" Grid.Column="1" Margin="5"/>
        <TextBlock Grid.Row="9" Grid.Column="0" Text="Кол-во на складе:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="CountBox" Grid.Row="9" Grid.Column="1" Margin="5"/>
        <TextBlock Grid.Row="10" Grid.Column="0" Text="Действующая скидка (%):" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="DiscountBox" Grid.Row="10" Grid.Column="1" Margin="5"/>
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Фото:" VerticalAlignment="Center" Margin="5"/>
        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="5">
            <Image x:Name="ProductImage" Width="80" Height="80" Stretch="Uniform" Margin="0,0,10,0"/>
            <Button Content="Выбрать фото" Click="ChangePhoto_Click" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="11" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,15,0,0">
            <Button Content="Сохранить" Width="120" Margin="0,0,10,0" Style="{StaticResource AccentButton}" Click="SaveButton_Click"/>
            <Button Content="Отмена" Width="100" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
